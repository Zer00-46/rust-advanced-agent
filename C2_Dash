import React, { useState, useEffect, useRef } from 'react';
import { 
  Terminal, 
  Shield, 
  Cpu, 
  FileText, 
  Activity, 
  Users, 
  Send, 
  Download, 
  Upload, 
  Camera, 
  Keyboard, 
  Power,
  Search,
  AlertCircle
} from 'lucide-react';

const C2Dashboard = () => {
  const [selectedVictim, setSelectedVictim] = useState(null);
  const [command, setCommand] = useState('');
  const [logs, setLogs] = useState([
    { type: 'system', text: 'C2 Server initialized. Listening on port 4444...' },
    { type: 'system', text: 'Waiting for incoming connections...' },
  ]);
  const [victims, setVictims] = useState([
    { id: 1, ip: '192.168.1.15', user: 'Admin-PC', os: 'Windows 10 Pro', status: 'Online', privilege: 'User' },
    { id: 2, ip: '10.0.0.42', user: 'Workstation-04', os: 'Windows 11', status: 'Online', privilege: 'SYSTEM' },
    { id: 3, ip: '172.16.5.11', user: 'Home-Laptop', os: 'Windows 10', status: 'Offline', privilege: 'User' },
  ]);

  const logEndRef = useRef(null);

  useEffect(() => {
    logEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [logs]);

  const addLog = (text, type = 'info') => {
    setLogs(prev => [...prev, { type, text: `[${new Date().toLocaleTimeString()}] ${text}` }]);
  };

  const handleSendCommand = (e) => {
    e.preventDefault();
    if (!selectedVictim) {
      addLog('Error: No victim selected!', 'error');
      return;
    }
    if (!command) return;

    addLog(`Sending command to ${selectedVictim.ip}: ${command}`, 'sent');
    
    // Simulação de resposta do agente Rust
    setTimeout(() => {
      let response = `Executed: ${command}\nResponse: Success. Operation completed.`;
      if (command === 'sysinfo') response = `OS: ${selectedVictim.os}\nUser: ${selectedVictim.user}\nPrivilege: ${selectedVictim.privilege}\nArch: x64`;
      if (command === 'persist') response = `Persistence configured successfully in HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run`;
      
      addLog(`Response from ${selectedVictim.ip}:\n${response}`, 'received');
    }, 800);

    setCommand('');
  };

  const quickCommand = (cmd) => {
    setCommand(cmd);
  };

  return (
    <div className="flex h-screen bg-[#0a0a0c] text-gray-300 font-mono overflow-hidden">
      {/* Sidebar - Victim List */}
      <div className="w-80 bg-[#111114] border-r border-gray-800 flex flex-col">
        <div className="p-4 border-b border-gray-800 flex items-center gap-2 text-red-500 font-bold">
          <Shield size={20} />
          <span>SKYNET C2 PANEL</span>
        </div>
        
        <div className="p-4">
          <div className="relative">
            <Search className="absolute left-3 top-2.5 text-gray-500" size={16} />
            <input 
              type="text" 
              placeholder="Search victims..." 
              className="w-full bg-[#1a1a1e] border border-gray-700 rounded-md py-2 pl-10 pr-4 text-sm focus:outline-none focus:border-red-600 transition-colors"
            />
          </div>
        </div>

        <div className="flex-1 overflow-y-auto">
          {victims.map(v => (
            <div 
              key={v.id}
              onClick={() => setSelectedVictim(v)}
              className={`p-4 cursor-pointer border-b border-gray-800 transition-all ${selectedVictim?.id === v.id ? 'bg-red-900/20 border-l-4 border-l-red-600' : 'hover:bg-[#1a1a1e]'}`}
            >
              <div className="flex justify-between items-start mb-1">
                <span className="font-bold text-gray-100">{v.user}</span>
                <span className={`text-[10px] px-2 py-0.5 rounded-full ${v.status === 'Online' ? 'bg-green-900/30 text-green-500' : 'bg-gray-700 text-gray-400'}`}>
                  {v.status}
                </span>
              </div>
              <div className="text-xs text-gray-500 flex flex-col gap-1">
                <span>IP: {v.ip}</span>
                <span className="flex items-center gap-1">
                  <Cpu size={12} /> {v.os}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex flex-col">
        {selectedVictim ? (
          <>
            {/* Top Bar - Victim Info */}
            <div className="h-16 bg-[#111114] border-b border-gray-800 flex items-center justify-between px-6">
              <div className="flex items-center gap-4">
                <div className="flex items-center gap-2 text-gray-100">
                  <Users size={18} className="text-red-500" />
                  <span className="font-bold">{selectedVictim.user}</span>
                  <span className="text-gray-600">|</span>
                  <span className="text-sm text-gray-400">{selectedVictim.ip}</span>
                </div>
                <div className="flex items-center gap-2 bg-gray-800 px-2 py-1 rounded text-[10px] text-gray-300">
                  <Shield size={12} />
                  <span>PRIV: {selectedVictim.privilege}</span>
                </div>
              </div>
              <div className="flex gap-2">
                <button onClick={() => quickCommand('persist')} className="flex items-center gap-1 bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded text-xs transition-colors">
                  <Activity size={14} /> Persist
                </button>
                <button onClick={() => quickCommand('sysinfo')} className="flex items-center gap-1 bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded text-xs transition-colors">
                  <Cpu size={14} /> SysInfo
                </button>
                <button className="flex items-center gap-1 bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs transition-colors">
                  <Power size={14} /> Kill
                </button>
              </div>
            </div>

            {/* Terminal Area */}
            <div className="flex-1 flex overflow-hidden">
              {/* Terminal */}
              <div className="flex-1 flex flex-col bg-[#0d0d0f] p-4">
                <div className="flex-1 overflow-y-auto mb-4 space-y-2 scrollbar-hide">
                  {logs.map((log, i) => (
                    <div key={i} className={`text-sm ${
                      log.type === 'system' ? 'text-blue-400' : 
                      log.type === 'error' ? 'text-red-500' : 
                      log.type === 'sent' ? 'text-gray-500 italic' : 
                      'text-green-400'
                    }`}>
                      <span className="opacity-50 mr-2">{log.text.split(']')[0]}]</span>
                      {log.text.split(']')[1]}
                    </div>
                  ))}
                  <div ref={logEndRef} />
                </div>
                
                <form onSubmit={handleSendCommand} className="flex gap-2 bg-[#1a1a1e] p-2 rounded-lg border border-gray-800">
                  <Terminal size={20} className="text-gray-500 mt-1 ml-2" />
                  <input 
                    type="text" 
                    value={command}
                    onChange={(e) => setCommand(e.target.value)}
                    placeholder="Enter command (e.g. whoami, dir, persist)..." 
                    className="flex-1 bg-transparent border-none focus:outline-none text-sm py-2"
                  />
                  <button type="submit" className="bg-red-600 hover:bg-red-700 text-white p-2 rounded-md transition-colors">
                    <Send size={18} />
                  </button>
                </form>
              </div>

              {/* Quick Actions Panel */}
              <div className="w-64 bg-[#111114] border-l border-gray-800 p-4 flex flex-col gap-4">
                <h3 className="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Quick Modules</h3>
                
                <div className="grid grid-cols-1 gap-2">
                  <button onClick={() => quickCommand('screenshot')} className="flex items-center gap-3 p-3 bg-[#1a1a1e] hover:bg-red-900/20 border border-gray-800 rounded-lg text-sm transition-all group">
                    <Camera size={18} className="text-gray-500 group-hover:text-red-500" />
                    <span>Screenshot</span>
                  </button>
                  <button onClick={() => quickCommand('keylog')} className="flex items-center gap-3 p-3 bg-[#1a1a1e] hover:bg-red-900/20 border border-gray-800 rounded-lg text-sm transition-all group">
                    <Keyboard size={18} className="text-gray-500 group-hover:text-red-500" />
                    <span>Keylogger</span>
                  </button>
                  <button onClick={() => quickCommand('download')} className="flex items-center gap-3 p-3 bg-[#1a1a1e] hover:bg-red-900/20 border border-gray-800 rounded-lg text-sm transition-all group">
                    <Download size={18} className="text-gray-500 group-hover:text-red-500" />
                    <span>File Downloader</span>
                  </button>
                  <button onClick={() => quickCommand('upload')} className="flex items-center gap-3 p-3 bg-[#1a1a1e] hover:bg-red-900/20 border border-gray-800 rounded-lg text-sm transition-all group">
                    <Upload size={18} className="text-gray-500 group-hover:text-red-500" />
                    <span>File Uploader</span>
                  </button>
                </div>

                <div className="mt-auto p-4 bg-red-900/10 border border-red-900/30 rounded-lg">
                  <div className="flex items-center gap-2 text-red-500 text-xs font-bold mb-1">
                    <AlertCircle size={14} />
                    <span>SECURITY ALERT</span>
                  </div>
                  <p className="text-[10px] text-gray-400 leading-relaxed">
                    Target is running Windows Defender. Use obfuscated payloads for new injections.
                  </p>
                </div>
              </div>
            </div>
          </>
        ) : (
          <div className="flex-1 flex flex-col items-center justify-center text-gray-600">
            <div className="bg-[#111114] p-8 rounded-full mb-4 border border-gray-800">
              <Users size={48} className="text-gray-700" />
            </div>
            <p className="text-lg font-medium">No Victim Selected</p>
            <p className="text-sm">Select a target from the sidebar to begin operations.</p>
          </div>
        )}
      </div>
    </div>
  );
};
